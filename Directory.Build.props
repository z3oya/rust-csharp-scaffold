<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ScaffoldCalcDll>$(MSBuildThisFileDirectory)target\release\scaffold_calc.dll</ScaffoldCalcDll>
    <ScaffoldTextDll>$(MSBuildThisFileDirectory)target\release\scaffold_text.dll</ScaffoldTextDll>
  </PropertyGroup>
</Project>
