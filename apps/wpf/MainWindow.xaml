<Window x:Class="Scaffold.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="rust-csharp-scaffold (WPF)"
        Width="560" Height="200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="12">
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="ABox" Width="60" Text="2" />
            <TextBlock Text="+" VerticalAlignment="Center" Margin="6,0" />
            <TextBox x:Name="BBox" Width="60" Text="3" />
            <Button Content="Add" Click="OnAdd" Margin="12,0,0,0" />
            <TextBlock x:Name="AddResult" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <TextBox x:Name="NameBox" Width="140" Text="Ada" />
            <Button Content="Greet" Click="OnGreet" Margin="12,0,0,0" />
            <TextBlock x:Name="GreetResult" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <TextBlock Text="factor" VerticalAlignment="Center" />
            <TextBox x:Name="FactorBox" Width="60" Text="3" Margin="6,0,0,0" />
            <TextBlock Text="value" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBox x:Name="ValueBox" Width="80" Text="5" Margin="6,0,0,0" />
            <Button Content="Apply" Click="OnApply" Margin="12,0,0,0" />
            <TextBlock x:Name="EngineResult" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
